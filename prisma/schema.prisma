// Mielba — 建設業向け現場管理アプリ
// データモデル（要件定義書 v0.3 §5 準拠）
// 顧客（元請企業）を頂点に、現場を中心軸として各エンティティが紐づく。
// 将来フェーズ（原価・在庫・交通費・タイムライン）は nullable 項目として構造のみ確保する。
//
// 注: 区分は String + アプリ層(zod)で値を制約する。許容値は src/lib/constants.ts に集約。
//     （旧: SQLite。本番 Vercel 向けに PostgreSQL へ移行）

generator client {
  // native = ローカル / rhel-openssl-3.0.x = Vercel(サーバーレス) ランタイム
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  provider      = "prisma-client-js"
}

// 本番/Preview(Vercel) = PostgreSQL(Neon)。url=プール接続(pgbouncer)、directUrl=直結。
// ── ローカルで SQLite を使う場合は generator の binaryTargets を外し、datasource を
//    { provider = "sqlite"  url = env("DATABASE_URL") } に差し替える（.env: DATABASE_URL="file:./dev.db"）。
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")        // プール接続(pgbouncer)・アプリ実行時
  directUrl = env("POSTGRES_URL_NON_POOLING")   // 直結・マイグレーション/db push 時
}

// ──────────────────────── AppSetting（アプリ設定・会社情報） ────────────────────────
// シングルトン（id="singleton" の1行）。管理者が編集する全社設定。
model AppSetting {
  id               String   @id @default("singleton")
  companyName      String?
  companyAddress   String?
  companyPhone     String?
  invoiceNumber    String? // 自社のインボイス登録番号
  defaultStartTime String   @default("08:00") // 日報の作業開始の初期値
  defaultEndTime   String   @default("17:00") // 日報の作業終了の初期値
  updatedAt        DateTime @updatedAt
}

// ───────────────────────────── User（ユーザー） ─────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN | STAFF
  department   String?
  avatarColor  String   @default("#2f63f5")
  avatarImage  String? // プロフィール画像（任意）。data URL（軽量JPEG）。未設定なら色＋イニシャル表示。
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports        DailyReport[]
  comments       Comment[]
  assignedTodos  Todo[]          @relation("TodoAssignee")
  createdTodos   Todo[]          @relation("TodoCreator")
  events         CalendarEvent[] @relation("EventOwner")
  createdEvents  CalendarEvent[] @relation("EventCreator")
  assignments    SiteAssignment[]
  siteVisits     SiteVisit[]
  eventParticipations EventParticipant[]
  createdSites   Site[]          @relation("SiteCreator")
  notifications     Notification[]     @relation("UserNotifications")
  pushSubscriptions PushSubscription[] @relation("UserPushSubscriptions")
  siteMemos         SiteMemo[]         @relation("SiteMemoAuthor")
}

// ─────────────────────── Customer（顧客／元請企業マスター） ───────────────────────
model Customer {
  id                 String   @id @default(cuid())
  name               String // 会社名（正式名称）— 表記統一の基準
  corporateNumber    String? // 法人番号 13桁
  invoiceNumber      String? // インボイス登録番号 T+13桁
  industry           String? // 業種
  capitalScale       String? // 資本金規模
  registrationType   String   @default("PRIME") // PRIME(元請) | SUBCONTRACTOR(一次下請) | OWNER(施主)
  tradeStatus        String   @default("NEW") // NEW(新規) | CONTINUING(継続) | SUSPENDED(取引停止)
  firstTradeDate     DateTime?

  // 住所
  headOfficeAddress  String? // 本社住所
  billingAddress     String? // 請求書送付先住所（本社と異なる場合）

  // 入金・請求条件
  closingDay         String? // 締め日（例: 末締め）
  paymentDueTerm     String? // 支払期日
  paymentMethod      String? // BANK(振込) | NOTE(手形) | DENSAI(でんさい)
  feeBearer          String? // 振込手数料の負担区分

  // その他
  memo               String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contacts ContactPerson[]
  sites    Site[]
}

// ──────────────────────── ContactPerson（顧客の担当者） ────────────────────────
model ContactPerson {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  department  String? // 部署
  position    String? // 役職
  phone       String?
  mobile      String?
  email       String?
  contactType String   @default("SITE") // SITE(現場) | ACCOUNTING(経理) | APPROVER(決裁)
  isActive    Boolean  @default(true) // 異動対応（過去担当は false）
  activeFrom  DateTime?
  activeTo    DateTime?
  note        String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ───────────────────────── Site（現場／案件マスター） ─────────────────────────
model Site {
  id               String   @id @default(cuid())
  customerId       String
  name             String // 案件名
  projectCode      String? // 案件コード
  constructionCode String? // 工事コード
  projectType      String   @default("REFORM") // REFORM | RENOVATION | NEWBUILD | MAINTENANCE
  projectStatus    String   @default("ESTIMATING") // ESTIMATING|ORDERED|STARTED|IN_PROGRESS|COMPLETED|CLOSED
  siteStatus       String   @default("SURVEY") // SURVEY(現調) | ACTIVE(進行中) | DECLINED(見送り) | PAST(過去)

  // 場所・契約
  locationName     String? // 作業場所の名称
  address          String? // 住所
  keybox           String? // キーBOX（設置場所・解錠情報）
  siteContactName  String? // 現場側担当者名
  receivedDate     DateTime? // 受注日
  contractNumber   String? // 契約書番号

  // 体制
  departmentInCharge String? // 自社担当部署
  siteManager        String? // 現場責任者
  salesRep           String? // 営業担当

  // 工程・期間
  plannedStartDate DateTime? // 着工予定日
  plannedEndDate   DateTime? // 完工予定日
  actualStartDate  DateTime? // 着工実績日
  actualEndDate    DateTime? // 完工実績日
  progressRate     Int      @default(0) // 進捗率（%）

  // 引き継ぎ
  handoverNote     String? // 引き継ぎ事項（前回状況・注意点・残作業）

  // ── v0.4 追加：現場連絡先・キーBOX・工数 ──
  siteContactPhone String? // 現場側担当者の電話番号
  keyboxNumber     String? // キーBOXの番号
  keyboxPlace      String? // キーBOXの設置場所
  targetManDays    Int? // 目標人工（工数）
  finalManDays     Int? // 最終人工（実績）

  // ── 要望対応：作成者・キーBOXあり/なし・仮登録 ──
  createdById      String? // 作成者（現場を登録したユーザー）
  keyboxStatus     String? // "HAS"(あり) | "NONE"(なし)
  keyboxNoneReason String? // キーBOXなしの理由（NONE時に必須）
  keyboxPhotoNoneReason String? // キーBOX写真が撮れない理由（写真なし時に必須）
  drawingNoneReason String? // 図面が無い理由（図面なし時に必須）
  scheduleNoneReason String? // 工程表が無い理由（工程表なし時に必須）
  provisional      Boolean @default(false) // 仮登録（必須項目が未入力）
  registrationConfirmed Boolean @default(false) // 管理者が「本登録にする」を押した（必須が欠けていても以後は仮登録に戻さない）

  memo             String? // 備考（現場情報に常設）。0024 で旧・現場メモ（SiteMemo）の本文を移植

  // ── AI分析（人工超過・工事完了）。再分析で上書き（最新のみ保持） ──
  overrunAnalysis      String?   // 人工超過のAI分析
  overrunAnalyzedAt    DateTime? // 人工超過分析の実行日時
  completionAnalysis   String?   // 工事完了（振り返り）のAI分析
  completionAnalyzedAt DateTime? // 完了分析の実行日時

  // ── 将来フェーズ：金額・収支（項目定義のみ。入力UI/集計は将来有効化） ──
  billingStatus     String? // 未請求|請求済|一部入金|入金完了
  contractAmount    Int? // 契約金額（請負金額）
  estimateAmount    Int? // 見積金額
  orderAmount       Int? // 受注金額
  budgetCost        Int? // 予算原価
  executionBudget   Int? // 実行予算
  actualMaterialCost Int? // 原価実績：材料費
  actualLaborCost    Int? // 原価実績：労務費
  actualOutsourceCost Int? // 原価実績：外注費
  actualExpenseCost  Int? // 原価実績：経費
  billedAmount      Int? // 請求済金額
  paidAmount        Int? // 入金済金額
  grossProfit       Int? // 粗利

  // ── 将来フェーズ：法令・書類（項目定義のみ） ──
  constructionPermitNumber String? // 建設業許可番号
  hasConstructionSystemLedger Boolean? // 施工体制台帳
  hasSafetyDocuments       Boolean? // 安全書類
  hasAttachedDrawings      Boolean? // 図面・帳票添付フラグ

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("SiteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  survey      Survey?
  reports     DailyReport[]
  events      CalendarEvent[]
  todos       Todo[]
  assignments SiteAssignment[]
  partners    SitePartner[]
  visits      SiteVisit[]
  photos      Photo[] // 現場に直接紐づく写真（図面・工程表・キーBOX等）
  handovers   Handover[]
  siteMaterials SiteMaterial[] // 現場に登録した材料（納品書/発注書のOCR登録・最高管理者のみ）
  memos         SiteMemo[] // 現場メモ（日報以外の気づき・連絡を時系列で残す）

  // 関連現場リンク（同一住所）— 双方向に検索する
  relationsA SiteRelation[] @relation("SiteRelationA")
  relationsB SiteRelation[] @relation("SiteRelationB")

  @@index([customerId])
  @@index([siteStatus])
  @@index([provisional])
}

// ──────────────────────── SiteMemo（現場メモ・時系列） ────────────────────────
// 日報以外の「現場に関する気づき・連絡・覚え書き」を現場詳細の先頭から誰でも残せる。
// 上書き型の旧 Site.memo と違い、投稿者・日時つきで積み上げ、全員が同じ形で読める。
model SiteMemo {
  id          String   @id @default(cuid())
  siteId      String
  content     String // 本文（改行そのまま表示）
  atSurvey    Boolean  @default(false) // 現調のときに書いたメモ（一覧で「現調」と表示する）
  createdById String? // 投稿者（退職などで削除されても本文は残す）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("SiteMemoAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  photos    Photo[] // メモに添えた写真・動画（現場の様子をその場で共有する）

  @@index([siteId, createdAt])
}

// 協力会社（下請）情報
model SitePartner {
  id      String  @id @default(cuid())
  siteId  String
  name    String
  role    String? // 担当工種・役割
  contact String?
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// 職人の割当（現場 × ユーザー）— 日報の個人×日と連動
model SiteAssignment {
  id     String @id @default(cuid())
  siteId String
  userId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
}

// 現場入り（出面）— その日「誰がどの現場に行くか」。日報の起点。
// 配属(SiteAssignment, 静的なメンバープール)とは別概念で、日ごとに変わる。
model SiteVisit {
  id          String   @id @default(cuid())
  siteId      String
  userId      String
  date        DateTime // 対象日（ローカル午前0時）
  note        String?
  createdById String? // 入力者（管理者の配員 or 本人の自己申告）
  mainVote    String? // メインの人の投票先 userId（対象日・現場の各配員が投票。全員一致で確定）
  createdAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId, date])
  @@index([userId, date])
  @@index([siteId, date])
  @@index([date])
}

// 関連現場リンク（同一住所の現場を相互参照）
model SiteRelation {
  id          String @id @default(cuid())
  siteAId     String
  siteBId     String
  note        String?
  createdAt   DateTime @default(now())
  siteA Site @relation("SiteRelationA", fields: [siteAId], references: [id], onDelete: Cascade)
  siteB Site @relation("SiteRelationB", fields: [siteBId], references: [id], onDelete: Cascade)

  @@unique([siteAId, siteBId])
  @@index([siteAId])
  @@index([siteBId])
}

// ──────────────────────────── Survey（現調記録） ────────────────────────────
model Survey {
  id            String   @id @default(cuid())
  siteId        String   @unique
  address       String? // 住所
  keybox        String? // キーBOX
  situationMemo String? // 現場状況メモ（調査時の所見）
  relatedNote   String? // 関連現場メモ
  surveyedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  photos Photo[]
}

// ─────────────────────────── DailyReport（日報） ───────────────────────────
// 入力単位は「個人 × 日」。同一現場・同一日に複数人分が並列で存在する。
model DailyReport {
  id          String   @id @default(cuid())
  siteId      String
  userId      String
  workDate    DateTime // 作業日
  startTime   String   @default("08:00") // 作業開始（勤怠を内包・初期値8:00）
  endTime     String   @default("17:00") // 作業終了（勤怠を内包・初期値17:00）
  detail      String? // 作業内容（当日の作業内容・状況）
  aiSummary   String? // （旧）AI要約。現在は未使用
  aiDraft     String? // 現場詳細（AI下書き・箇条書き）。AIサポートで各項目へ振り分ける入力元
  memo        String? // （旧）注意点メモ。現在は未使用（引き継ぎ事項へ一本化）
  status      String   @default("DRAFT") // DRAFT(未提出) | SUBMITTED(提出済)
  submittedAt DateTime?
  parkingFee  Int? // 駐車場代（円）。なし選択時は0
  trainFare   Int? // 電車賃（円）。なし選択時は0
  handover    String? // 引き継ぎ事項（次の担当者への申し送り）
  handoverNone Boolean? // 引き継ぎ「なし」を明示選択（handover 空と未入力を区別）
  timeChangeReason String? // 作業時間が 8:00-17:00 外のときの変更理由（必須）
  stockUsed   Boolean? // 在庫材料の使用 あり/なし
  stockNote   String? // 使用した在庫材料の内容（stockUsed=true 時）
  absent        Boolean @default(false) // 現場不参加（休み等）。提出扱いだが稼働・人工には入れない
  absenceReason String? // 不参加の理由: HOLIDAY(休み) | SICK(体調不良) | RESCHEDULED(予定変更) | OTHER_SITE(別現場) | OTHER(その他)
  absenceNote   String? // 不参加の理由が「その他」のときの1行メモ
  nextWorkChoice      String? // 次回の作業日: DATE(日付あり) | UNDECIDED(未定) | DONE(次回なし)。メインの人が提出時に必須
  nextWorkDate        DateTime? // 次回作業日（DATE のとき。予定に「次回工程」として登録）
  nextCheckDate       DateTime? // 未定のとき「いつまでに確認するか」。この日に通知＋全画面で決めさせる
  nextCheckResolvedAt DateTime? // 確認の件を片づけた日時（日付を決めた／後の日報で上書き）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials     MaterialUse[]
  stockUses     StockUse[]
  expenses      ReportExpense[]
  orders        MaterialOrder[]
  nextProcesses NextProcess[]
  photos        Photo[]
  comments      Comment[]

  @@index([siteId])
  @@index([userId])
  @@index([workDate])
  @@unique([siteId, userId, workDate]) // 個人×日×現場で1枚
}

// 使用材料・数量
model MaterialUse {
  id       String  @id @default(cuid())
  reportId String
  name     String
  quantity String? // 数量（単位込みの自由入力も許容）
  unit     String?
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// 在庫材料の使用・数量（在庫材料マスター MaterialMaster から選択）。
// 現場に紐づく使用材料(MaterialUse)とは別枠で、弊社在庫（ストック品）の使用を記録する。
model StockUse {
  id       String  @id @default(cuid())
  reportId String
  name     String
  quantity String? // 使用数量（単位込みの自由入力も許容）
  unit     String?
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// 経費（駐車場代は DailyReport.parkingFee の固定行。ここは任意で「＋追加」する経費）
model ReportExpense {
  id        String @id @default(cuid())
  reportId  String
  label     String // 名目（高速代・材料立替 等）
  amount    Int // 金額（円）
  sortOrder Int    @default(0)
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// 材料発注 → 配達予定日
model MaterialOrder {
  id           String   @id @default(cuid())
  reportId     String
  name         String
  quantity     String?
  supplier     String?
  deliveryDate DateTime? // 配達予定日（カレンダー・現場ビューに反映）
  report       DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// 次回工程打合せ → 絡む業者 → 支給品納品日
model NextProcess {
  id                String   @id @default(cuid())
  reportId          String
  content           String? // 次回工程打合せ内容
  vendors           String? // 絡む業者（複数可・カンマ区切り）
  supplyDeliveryDate DateTime? // 支給品納品日（カレンダー・現場ビューに反映）
  report            DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ──────────────────────────── Comment（コメント） ────────────────────────────
model Comment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ──────────────────────────── Photo（写真／動画） ────────────────────────────
model Photo {
  id        String   @id @default(cuid())
  reportId  String?
  surveyId  String?
  siteId    String? // 現場直付けの写真（図面・工程表・キーBOX等）
  memoId    String? // 現場メモに添えた写真・動画
  dataUrl   String? // 圧縮済み base64（画像用。動画は blobPath 側に入る）
  thumbUrl  String? // サムネイル（base64、一覧表示用。動画は先頭フレーム）
  blobPath  String? // Vercel Blob 上のパス（動画など 4.5MB を超えうるファイル）
  mimeType  String? // blobPath がある場合の Content-Type
  sizeBytes Int? // blobPath がある場合のバイト数
  duration  Int? // 動画の長さ（秒）
  caption   String? // 連動する文章
  kind      String   @default("WORK") // WORK | COMPANY_STOCK(弊社分) | SURVEY | DRAWING(図面) | SCHEDULE(工程表) | KEYBOX(キーBOX) | OTHER
  isVideo   Boolean  @default(false)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  report DailyReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  survey Survey?      @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  memo   SiteMemo?    @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([surveyId])
  @@index([siteId])
  @@index([memoId])
}

// ──────────────────────── MaterialMaster（在庫材料マスター） ────────────────────────
// 現場に紐づかない「残っている在庫材料」を管理するマスター。管理者が編集する。
// 日報の「在庫材料の使用」の選択候補になる（現場ごとの使用材料は SiteMaterial 側）。
// ※内部モデル名は互換のため MaterialMaster のまま（UI表記は「在庫材料マスター」）。
model MaterialMaster {
  id            String   @id @default(cuid())
  name          String // 材料名
  unit          String? // 単位（枚・本・袋 等）
  stockQuantity Int? // 在庫数（残数）。棚卸し等で手動更新
  location      String? // 置き場所（任意）
  active        Boolean  @default(true) // 無効化（削除の代わり）
  sortOrder     Int      @default(0) // 表示順
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}

// ──────────────────── SiteMaterial（現場ごとの登録材料） ────────────────────
// 最高管理者(SUPER_ADMIN)が納品書/発注書の写真をOCRして現場に登録する材料。
// 日報の使用材料はこの一覧から選択する（スタッフには単価/金額を渡さない＝財務情報）。
model SiteMaterial {
  id           String    @id @default(cuid())
  siteId       String
  name         String // 材料名
  quantity     String? // 数量（単位込みの自由入力も許容）
  unit         String? // 単位（枚・本・袋 等）
  unitPrice    Int? // 単価（円）— 財務情報・最高管理者のみ閲覧
  amount       Int? // 金額（円・行合計）— 財務情報・最高管理者のみ閲覧
  documentType String? // "DELIVERY"(納品書) | "ORDER"(発注書)
  supplier     String? // 仕入先・業者（OCRで拾えれば）
  orderedAt    DateTime? // 伝票日付（OCRで拾えれば）
  photoId      String? // 元となった伝票写真の Photo.id（任意・弱参照）
  active       Boolean   @default(true) // 無効化（削除の代わり）
  createdById  String? // 登録者
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, active])
}

// ──────────────────────── Handover（引き継ぎ事項） ────────────────────────
// 現場ごとの申し送り。日報提出時に起票され、当日の配員が一人ずつ読んで確認する（HandoverRead）。
// resolvedAt は「対応完了」— 起票者か管理者が閉じたら、もう誰にも読ませない。
model Handover {
  id           String    @id @default(cuid())
  siteId       String
  reportId     String? // 起票元の日報（任意）
  content      String // 引き継ぎ内容
  createdById  String? // 起票者
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime? // 解決日時（null = 未解決）
  resolvedById String? // 解決者

  site  Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reads HandoverRead[]

  @@index([siteId])
  @@index([resolvedAt])
  @@index([siteId, resolvedAt])
}

// 引き継ぎの既読（人ごと）。当日の配員は全員が読んで確認するまで先に進めない。
model HandoverRead {
  id         String   @id @default(cuid())
  handoverId String
  userId     String // 確認した人（createdById と同じく緩い参照）
  readAt     DateTime @default(now())

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@unique([handoverId, userId])
  @@index([userId])
}

// ──────────────────────── CalendarEvent（現場・個人予定） ────────────────────────
model CalendarEvent {
  id          String   @id @default(cuid())
  siteId      String?
  ownerId     String? // 個人予定の所有者
  title       String
  date        DateTime // 予定日（日単位）
  startTime   String? // "HH:mm"（任意）
  endTime     String?
  allDay      Boolean  @default(true)
  category    String? // 予定のカテゴリー（打合せ/作業/検査/搬入/納品/その他）
  location    String? // 場所（現場住所の既定 or 自由入力）
  note        String? // 内容
  source      String   @default("MANUAL") // MANUAL | DELIVERY(配達) | SUPPLY(支給品) | PROCESS(工程) | MILESTONE
  isPrivate   Boolean  @default(false) // 非公開（最高管理者の個人予定のみ）。所有者以外の画面には出さない
  reportId    String? // 日報由来の予定の出所
  createdById String?
  createdAt   DateTime @default(now())

  site         Site?              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  owner        User?              @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants EventParticipant[]

  @@index([siteId])
  @@index([date])
}

// 予定の参加者（現場に行く人・複数）。SITE予定では現場入り(SiteVisit)にも連動する。
model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ──────────────────────────────── Todo（タスク） ────────────────────────────────
model Todo {
  id          String   @id @default(cuid())
  siteId      String? // 現場TODO（null なら個人TODO）
  scope       String   @default("SITE") // SITE | PERSONAL
  title       String
  detail      String?
  assigneeId  String?
  createdById String?
  dueDate     DateTime?
  status      String   @default("OPEN") // OPEN(未対応) | IN_PROGRESS(対応中) | DONE(完了)
  fromReportId String? // 日報の継続事項から起票
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site      Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignee  User? @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User? @relation("TodoCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([assigneeId])
  @@index([status])
}

// ──────────────────────── Notification（アプリ内通知） ────────────────────────
// Cron やアクションが生成する受信者ごとの通知。既読管理・起動ゲート・ホーム表示に使う。
model Notification {
  id        String   @id @default(cuid())
  userId    String // 受信者
  type      String // PROVISIONAL | REPORT_MISSING | WEEKLY_MISSING | MANDAYS_OVER 等
  title     String
  body      String?
  href      String? // タップ時の遷移先
  read      Boolean  @default(false)
  siteId    String? // 関連現場（任意）
  reportId  String? // 関連日報（任意）
  dedupeKey String? // 重複生成防止キー（Cron用。userId と組で一意）
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, read])
}

// ──────────────────── PushSubscription（Web Push 購読情報） ────────────────────
// 端末プッシュ通知の送信先。ユーザー操作で購読し保存する。
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────── TrashItem（ごみ箱：削除した現場・日報・顧客を30日戻せる） ────────────────────────
// 削除の直前に、その行と一緒に消える子の行を丸ごと JSON(snapshot) に保存する。戻すときは同じ ID で入れ直す。
model TrashItem {
  id          String    @id @default(cuid())
  kind        String // SITE | REPORT | CUSTOMER
  label       String // 一覧に出す名前（現場名・「10/9 現場名・氏名」・顧客名）
  snapshot    String // TrashSnapshot の JSON
  deletedById String?
  deletedAt   DateTime  @default(now())
  restoredAt  DateTime? // 元に戻した日時（戻したものは一覧に出さない）

  @@index([deletedAt])
}
